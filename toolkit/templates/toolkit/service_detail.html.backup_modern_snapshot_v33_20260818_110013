{% extends "base.html" %}

{% block title %}
{{ service.title }} | BharatNXT Wave
{% endblock %}


{% block content %}

<!-- BDE_CALL_WORKSPACE_V2 -->
<!-- BDE_CALL_WORKSPACE_V2_1_SOURCE_DEDUP -->
<!-- BDE_CALL_WORKSPACE_V3_VERBATIM_FIRST_SCREEN -->

<style id="bnx-v3-verbatim-first-screen-styles">

    .bnx-v2-page .bnx-v2-topbar {
        margin-bottom: 10px;
    }

    .bnx-v2-page .bnx-v3-scheme-hero {
        padding: 14px 20px;
        border-radius: 14px;
        box-shadow: 0 5px 18px rgba(16, 24, 40, 0.04);
    }

    .bnx-v2-page .bnx-v3-scheme-hero h1 {
        max-width: none;
        font-size: clamp(24px, 2.25vw, 34px);
        line-height: 1.1;
    }

    .bnx-v3-verbatim-board {
        display: grid;
        grid-template-columns: 0.95fr 1fr 1.15fr;
        align-items: stretch;
        gap: 10px;
        min-height: 0;
        margin-top: 10px;
        margin-bottom: 0;
    }

    .bnx-v3-verbatim-card {
        min-width: 0;
        padding: 0;
        overflow: hidden;
        border: 1px solid #d8dee8;
        border-radius: 14px;
        background: #ffffff;
        box-shadow: 0 5px 18px rgba(16, 24, 40, 0.035);
    }

    .bnx-v3-verbatim-card.benefits {
        background: #fff3e4;
        border-color: #f0d3b4;
    }

    .bnx-v3-verbatim-card.focus-sectors {
        background: #eef7e9;
        border-color: #cfe2c5;
    }

    .bnx-v3-verbatim-card.eligibility {
        background: #fff4ce;
        border-color: #ead58d;
    }

    .bnx-v3-verbatim-card > header {
        padding: 10px 14px 9px;
        border-bottom: 1px solid rgba(16, 24, 40, 0.12);
        background: rgba(255, 255, 255, 0.46);
    }

    .bnx-v3-verbatim-card h2 {
        margin: 0;
        color: #101828;
        font-size: 16px;
        font-weight: 800;
        letter-spacing: -0.015em;
        line-height: 1.2;
    }

    .bnx-v3-verbatim-content {
        padding: 12px 14px;
        color: #172033;
        font-size: clamp(12px, 0.9vw, 15px);
        font-weight: 600;
        line-height: 1.42;
        overflow-wrap: anywhere;
        white-space: pre-wrap;
    }

    .bnx-v3-verbatim-missing {
        color: #667085;
        font-style: italic;
        font-weight: 500;
    }

    @media (max-width: 900px) {

        .bnx-v3-verbatim-board {
            grid-template-columns: 1fr;
            min-height: 0;
        }

    }

</style>

<div class="bnx-v2-page">

    <div class="bnx-v2-topbar">

        <a
            href="{% url 'toolkit:service_library' %}"
            class="bnx-v2-back">

            <span aria-hidden="true">←</span>
            Service Library

        </a>


        <div class="bnx-v2-top-actions">

            <form
                method="post"
                action="{% url 'toolkit:toggle_saved_service' service.pk %}"
                class="bde-ajax-save">

                {% csrf_token %}

                <input
                    type="hidden"
                    name="next"
                    value="{{ request.path }}">

                <button
                    type="submit"
                    class="secondary-button bnx-v2-save {% if is_saved %}saved{% endif %}">

                    {% if is_saved %}
                        <span class="bn-bookmark-icon is-saved" aria-hidden="true"></span>
                        <span>Saved / organise</span>
                    {% else %}
                        <span class="bn-bookmark-icon" aria-hidden="true"></span>
                        <span>Save for client</span>
                    {% endif %}

                </button>

            </form>


            {% if primary_source and primary_source.source_url %}

                <a
                    href="{{ primary_source.source_url }}"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="bde-external-button">

                    Open official source ↗

                </a>

            {% endif %}

        </div>

    </div>


    <header class="bnx-v2-hero bnx-v3-scheme-hero">

        <h1>
            {{ service.title }}
        </h1>

    </header>


    <section
        class="bnx-v3-verbatim-board"
        aria-label="Scheme benefits, focus sectors and eligibility criteria">

        <article class="bnx-v3-verbatim-card benefits">

            <header>
                <h2>Benefits</h2>
            </header>

            <div class="bnx-v3-verbatim-content">{% if verbatim_benefits %}{{ verbatim_benefits }}{% else %}<span class="bnx-v3-verbatim-missing">Not recorded in the approved imported source.</span>{% endif %}</div>

        </article>


        <article class="bnx-v3-verbatim-card focus-sectors">

            <header>
                <h2>Focus Sectors</h2>
            </header>

            <div class="bnx-v3-verbatim-content">{% if verbatim_focus_sectors %}{{ verbatim_focus_sectors }}{% else %}<span class="bnx-v3-verbatim-missing">Not recorded in the approved imported source.</span>{% endif %}</div>

        </article>


        <article class="bnx-v3-verbatim-card eligibility">

            <header>
                <h2>Eligibility Criteria</h2>
            </header>

            <div class="bnx-v3-verbatim-content">{% if verbatim_eligibility %}{{ verbatim_eligibility }}{% else %}<span class="bnx-v3-verbatim-missing">Not recorded in the approved imported source.</span>{% endif %}</div>

        </article>

    </section>


    <div class="bnx-v2-workspace">

        <main class="bnx-v2-main">

            <section class="bnx-v2-priority-block">

                <div class="bnx-v2-priority-heading">

                    <span>2</span>

                    <div>
                        <small>CLIENT GETS</small>
                        <strong>Lead with the outcome</strong>
                    </div>

                </div>


                <div class="bnx-v2-readable-copy">

                    {% if service.benefits %}

                        {{ service.benefits|truncatechars:440|linebreaks }}

                    {% elif service.subsidy_details %}

                        {{ service.subsidy_details|truncatechars:440|linebreaks }}

                    {% elif service.funding_min != None or service.funding_max != None %}

                        <p>
                            Funding information is recorded for this service.
                            Confirm the exact amount and conditions in the
                            full funding details below.
                        </p>

                    {% else %}

                        <p class="bnx-v2-muted">
                            A separate verified benefit summary is not recorded.
                            Check the complete Toolkit and official-source sections
                            before describing the outcome.
                        </p>

                    {% endif %}

                </div>


                {% if service.funding_min != None or service.funding_max != None or service.funding_type or service.funding_organisation or service.subsidy_details %}

                    <div class="bnx-v2-fact-row">

                        {% if service.funding_type %}

                            <div>
                                <span>Funding type</span>
                                <strong>{{ service.funding_type }}</strong>
                            </div>

                        {% endif %}


                        {% if service.funding_organisation %}

                            <div>
                                <span>Funding organisation</span>
                                <strong>{{ service.funding_organisation }}</strong>
                            </div>

                        {% endif %}


                        {% if service.funding_min != None or service.funding_max != None %}

                            <div>
                                <span>Recorded range</span>
                                <strong>

                                    {% if service.funding_min != None %}
                                        ₹{{ service.funding_min }}
                                    {% endif %}

                                    {% if service.funding_min != None and service.funding_max != None %}
                                        –
                                    {% endif %}

                                    {% if service.funding_max != None %}
                                        ₹{{ service.funding_max }}
                                    {% endif %}

                                </strong>
                            </div>

                        {% endif %}

                    </div>

                {% endif %}

            </section>


            <section class="bnx-v2-priority-block">

                <div class="bnx-v2-priority-heading">

                    <span>3</span>

                    <div>
                        <small>BEST FOR</small>
                        <strong>Quick fit check</strong>
                    </div>

                </div>


                <div class="bnx-v2-readable-copy">

                    {% if service.eligibility_summary %}

                        {{ service.eligibility_summary|truncatechars:420|linebreaks }}

                    {% elif service.applicable_for_raw %}

                        {{ service.applicable_for_raw|truncatechars:420|linebreaks }}

                    {% elif service.business_types %}

                        <p>
                            Recorded entity types:
                            {{ service.business_types|join:", " }}.
                        </p>

                    {% else %}

                        <p class="bnx-v2-muted">
                            No short eligibility statement is recorded.
                            Open Full eligibility before confirming fit.
                        </p>

                    {% endif %}

                </div>


                {% if service.business_types or service.business_stages or service.industries or service.applicable_states or service.founder_categories %}

                    <div class="bnx-v2-chip-row">

                        {% if service.business_types %}
                            <span>{{ service.business_types|join:", " }}</span>
                        {% endif %}

                        {% if service.business_stages %}
                            <span>{{ service.business_stages|join:", " }}</span>
                        {% endif %}

                        {% if service.industries %}
                            <span>{{ service.industries|join:", " }}</span>
                        {% endif %}

                        {% if service.applicable_states %}
                            <span>{{ service.applicable_states|join:", " }}</span>
                        {% endif %}

                        {% if service.founder_categories %}
                            <span>{{ service.founder_categories|join:", " }}</span>
                        {% endif %}

                    </div>

                {% endif %}

            </section>

        </main>


        <aside class="bnx-v2-rail">

            <section class="bnx-v2-deadline-card">

                <div class="bnx-v2-priority-heading">

                    <span>4</span>

                    <div>
                        <small>DEADLINE</small>
                        <strong>Check before promising</strong>
                    </div>

                </div>


                <div class="bnx-v2-deadline-value">
                    {{ service.bde_deadline_label }}
                </div>


                <div class="bnx-v2-rail-facts">

                    <div>
                        <span>Pitch status</span>
                        <strong>{{ service.pitch_state_label }}</strong>
                    </div>


                    {% if service.effective_from %}

                        <div>
                            <span>Pitch from</span>
                            <strong>{{ service.effective_from|date:"d M Y" }}</strong>
                        </div>

                    {% endif %}


                    {% if service.pitch_until %}

                        <div>
                            <span>Pitch until</span>
                            <strong>{{ service.pitch_until|date:"d M Y" }}</strong>
                        </div>

                    {% endif %}


                    {% if service.estimated_processing_time %}

                        <div>
                            <span>Estimated processing</span>
                            <strong>{{ service.estimated_processing_time }}</strong>
                        </div>

                    {% endif %}

                </div>

            </section>


            <section class="bnx-v2-action-card">

                <div class="bnx-v2-priority-heading">

                    <span>7</span>

                    <div>
                        <small>KEY ACTIONS</small>
                        <strong>Move the call forward</strong>
                    </div>

                </div>


                <div class="bnx-v2-action-stack">

                    <a
                        href="{% url 'toolkit:client_matcher' %}?service={{ service.pk }}"
                        class="primary-button">

                        Check for this client

                    </a>


                    <form
                        method="post"
                        action="{% url 'toolkit:toggle_saved_service' service.pk %}"
                        class="bde-ajax-save">

                        {% csrf_token %}

                        <input
                            type="hidden"
                            name="next"
                            value="{{ request.path }}">

                        <button
                            type="submit"
                            class="secondary-button bnx-v2-action-save {% if is_saved %}saved{% endif %}">

                            {% if is_saved %}
                                <span class="bn-bookmark-icon is-saved" aria-hidden="true"></span>
                                <span>Manage saved clients</span>
                            {% else %}
                                <span class="bn-bookmark-icon" aria-hidden="true"></span>
                                <span>Save to a client</span>
                            {% endif %}

                        </button>

                    </form>


                    {% if primary_source and primary_source.source_url %}

                        <a
                            href="{{ primary_source.source_url }}"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="bde-external-button">

                            Open official source ↗

                        </a>

                    {% endif %}


                    <a
                        href="#full-details"
                        class="bnx-v2-text-action">

                        Open complete Toolkit details

                    </a>

                </div>

            </section>

        </aside>

    </div>


    <div class="bnx-v2-call-checks">

        <section class="bnx-v2-question-panel">

            <div class="bnx-v2-priority-heading">

                <span>5</span>

                <div>
                    <small>ASK THE CLIENT</small>
                    <strong>Three checks before recommending</strong>
                </div>

            </div>


            <ol class="bnx-v2-question-list">

                <li>

                    <span>1</span>

                    <div>
                        <strong>What is the entity type and business stage?</strong>

                        <small>

                            {% if service.business_types %}
                                Recorded fit: {{ service.business_types|join:", " }}
                            {% elif service.applicable_for_raw %}
                                Recorded fit: {{ service.applicable_for_raw|truncatechars:150 }}
                            {% else %}
                                Confirm this against Full eligibility.
                            {% endif %}

                        </small>
                    </div>

                </li>


                <li>

                    <span>2</span>

                    <div>
                        <strong>Where does the business operate?</strong>

                        <small>

                            {% if service.applicable_states %}
                                Recorded location: {{ service.applicable_states|join:", " }}
                            {% else %}
                                Check whether location restrictions apply.
                            {% endif %}

                        </small>
                    </div>

                </li>


                <li>

                    <span>3</span>

                    <div>
                        <strong>Does the client meet the key thresholds?</strong>

                        <small>

                            {% if service.min_turnover != None or service.max_turnover != None %}
                                A turnover condition is recorded below.
                            {% elif service.min_business_age_months != None or service.max_business_age_months != None %}
                                A business-age condition is recorded below.
                            {% elif service.founder_categories %}
                                Founder category: {{ service.founder_categories|join:", " }}
                            {% else %}
                                Review all recorded eligibility conditions before confirming.
                            {% endif %}

                        </small>
                    </div>

                </li>

            </ol>

        </section>


        <section class="bnx-v2-warning-panel">

            <div class="bnx-v2-priority-heading">

                <span>6</span>

                <div>
                    <small>IMPORTANT CHECK</small>
                    <strong>Do not skip this</strong>
                </div>

            </div>


            <div class="bnx-v2-warning-copy">

                {% if service.restrictions %}

                    {{ service.restrictions|truncatechars:340|linebreaks }}

                {% elif service.important_notes %}

                    {{ service.important_notes|truncatechars:340|linebreaks }}

                {% elif service.escalation_notes %}

                    {{ service.escalation_notes|truncatechars:340|linebreaks }}

                {% elif service.internal_notes %}

                    {{ service.internal_notes|truncatechars:340|linebreaks }}

                {% else %}

                    <p>
                        Verify the latest official source before committing
                        an amount, eligibility decision or timeline to the client.
                    </p>

                {% endif %}

            </div>

        </section>

    </div>


    <section
        class="bnx-v2-details-section"
        id="full-details">

        <div class="bnx-v2-details-heading">

            <div>
                <small>ONLY WHEN NEEDED</small>
                <h2>Complete Toolkit details</h2>
                <p>
                    Open one section at a time while speaking to the client.
                </p>
            </div>

            <span>
                Nothing below changes the approved scheme data.
            </span>

        </div>


        <div class="bnx-v2-disclosures">

            {% if service.eligibility_summary or service.applicable_for_raw or eligibility_rules or service.business_types or service.business_stages or service.industries or service.applicable_states or service.founder_categories %}

                <details class="bnx-v2-disclosure">

                    <summary>

                        <span class="bnx-v2-summary-icon">01</span>

                        <span class="bnx-v2-summary-copy">
                            <strong>Full eligibility</strong>
                            <small>All recorded fit rules and thresholds</small>
                        </span>

                        <span class="bnx-v2-chevron" aria-hidden="true"></span>

                    </summary>


                    <div class="bnx-v2-disclosure-body">

                        {% if service.eligibility_summary %}

                            <div class="bnx-v2-long-copy">
                                {{ service.eligibility_summary|linebreaks }}
                            </div>

                        {% endif %}


                        {% if service.applicable_for_raw %}

                            <div class="bnx-v2-recorded-note">
                                <span>Applicable for</span>
                                <strong>{{ service.applicable_for_raw }}</strong>
                            </div>

                        {% endif %}


                        <div class="bnx-v2-detail-grid">

                            {% if service.business_types %}

                                <div>
                                    <span>Entity type</span>
                                    <strong>{{ service.business_types|join:", " }}</strong>
                                </div>

                            {% endif %}


                            {% if service.business_stages %}

                                <div>
                                    <span>Business stage</span>
                                    <strong>{{ service.business_stages|join:", " }}</strong>
                                </div>

                            {% endif %}


                            {% if service.industries %}

                                <div>
                                    <span>Industry / sector</span>
                                    <strong>{{ service.industries|join:", " }}</strong>
                                </div>

                            {% endif %}


                            {% if service.applicable_states %}

                                <div>
                                    <span>Location</span>
                                    <strong>{{ service.applicable_states|join:", " }}</strong>
                                </div>

                            {% endif %}


                            {% if service.founder_categories %}

                                <div>
                                    <span>Founder category</span>
                                    <strong>{{ service.founder_categories|join:", " }}</strong>
                                </div>

                            {% endif %}


                            {% if service.min_business_age_months != None %}

                                <div>
                                    <span>Minimum business age</span>
                                    <strong>{{ service.min_business_age_months }} months</strong>
                                </div>

                            {% endif %}


                            {% if service.max_business_age_months != None %}

                                <div>
                                    <span>Maximum business age</span>
                                    <strong>{{ service.max_business_age_months }} months</strong>
                                </div>

                            {% endif %}


                            {% if service.min_turnover != None %}

                                <div>
                                    <span>Minimum turnover</span>
                                    <strong>₹{{ service.min_turnover }}</strong>
                                </div>

                            {% endif %}


                            {% if service.max_turnover != None %}

                                <div>
                                    <span>Maximum turnover</span>
                                    <strong>₹{{ service.max_turnover }}</strong>
                                </div>

                            {% endif %}

                        </div>


                        {% if eligibility_rules %}

                            <div class="bnx-v2-rule-list">

                                {% for rule in eligibility_rules %}

                                    <article>
                                        <strong>{{ rule.title }}</strong>
                                        <p>{{ rule.description }}</p>
                                    </article>

                                {% endfor %}

                            </div>

                        {% endif %}

                    </div>

                </details>

            {% endif %}


            {% if document_requirements %}

                <details class="bnx-v2-disclosure">

                    <summary>

                        <span class="bnx-v2-summary-icon">02</span>

                        <span class="bnx-v2-summary-copy">
                            <strong>Documents required</strong>
                            <small>{{ document_requirements|length }} recorded item{{ document_requirements|length|pluralize }}</small>
                        </span>

                        <span class="bnx-v2-chevron" aria-hidden="true"></span>

                    </summary>


                    <div class="bnx-v2-disclosure-body">

                        <div class="bnx-v2-checklist">

                            {% for item in document_requirements %}

                                <article>

                                    <span class="{% if not item.is_mandatory %}optional{% endif %}">
                                        {% if item.is_mandatory %}✓{% else %}○{% endif %}
                                    </span>

                                    <div>
                                        <strong>{{ item.name }}</strong>

                                        {% if item.description %}
                                            <p>{{ item.description }}</p>
                                        {% endif %}

                                        <small>
                                            {% if item.is_mandatory %}Mandatory{% else %}Optional{% endif %}
                                        </small>
                                    </div>

                                </article>

                            {% endfor %}

                        </div>

                    </div>

                </details>

            {% endif %}


            {% if process_steps %}

                <details class="bnx-v2-disclosure">

                    <summary>

                        <span class="bnx-v2-summary-icon">03</span>

                        <span class="bnx-v2-summary-copy">
                            <strong>Process and next steps</strong>
                            <small>{{ process_steps|length }} recorded step{{ process_steps|length|pluralize }}</small>
                        </span>

                        <span class="bnx-v2-chevron" aria-hidden="true"></span>

                    </summary>


                    <div class="bnx-v2-disclosure-body">

                        <div class="bnx-v2-process-list">

                            {% for item in process_steps %}

                                <article>

                                    <span>{{ item.step_number }}</span>

                                    <div>
                                        <strong>{{ item.title }}</strong>

                                        {% if item.description %}
                                            <p>{{ item.description }}</p>
                                        {% endif %}

                                        {% if item.estimated_time %}
                                            <small>Estimated: {{ item.estimated_time }}</small>
                                        {% endif %}
                                    </div>

                                </article>

                            {% endfor %}

                        </div>

                    </div>

                </details>

            {% endif %}


            {% if commercial_terms or service.benefits or service.funding_type or service.funding_organisation or service.funding_min != None or service.funding_max != None or service.interest_rate_min != None or service.interest_rate_max != None or service.tenure or service.subsidy_details or service.government_fee != None or service.bharatnxt_fee != None or service.pricing_notes %}

                <details class="bnx-v2-disclosure">

                    <summary>

                        <span class="bnx-v2-summary-icon">04</span>

                        <span class="bnx-v2-summary-copy">
                            <strong>Benefits, funding and charges</strong>
                            <small>Full commercial and financial information</small>
                        </span>

                        <span class="bnx-v2-chevron" aria-hidden="true"></span>

                    </summary>


                    <div class="bnx-v2-disclosure-body">

                        {% if service.benefits %}

                            <div class="bnx-v2-long-copy">
                                {{ service.benefits|linebreaks }}
                            </div>

                        {% endif %}


                        {% if service.subsidy_details %}

                            <div class="bnx-v2-long-copy">
                                {{ service.subsidy_details|linebreaks }}
                            </div>

                        {% endif %}


                        <div class="bnx-v2-detail-grid">

                            {% if service.funding_type %}

                                <div>
                                    <span>Funding type</span>
                                    <strong>{{ service.funding_type }}</strong>
                                </div>

                            {% endif %}


                            {% if service.funding_organisation %}

                                <div>
                                    <span>Funding organisation</span>
                                    <strong>{{ service.funding_organisation }}</strong>
                                </div>

                            {% endif %}


                            {% if service.funding_min != None or service.funding_max != None %}

                                <div>
                                    <span>Funding range</span>
                                    <strong>

                                        {% if service.funding_min != None %}
                                            ₹{{ service.funding_min }}
                                        {% endif %}

                                        {% if service.funding_min != None and service.funding_max != None %}
                                            –
                                        {% endif %}

                                        {% if service.funding_max != None %}
                                            ₹{{ service.funding_max }}
                                        {% endif %}

                                    </strong>
                                </div>

                            {% endif %}


                            {% if service.interest_rate_min != None or service.interest_rate_max != None %}

                                <div>
                                    <span>Interest rate</span>
                                    <strong>

                                        {% if service.interest_rate_min != None %}
                                            {{ service.interest_rate_min }}%
                                        {% endif %}

                                        {% if service.interest_rate_min != None and service.interest_rate_max != None %}
                                            –
                                        {% endif %}

                                        {% if service.interest_rate_max != None %}
                                            {{ service.interest_rate_max }}%
                                        {% endif %}

                                    </strong>
                                </div>

                            {% endif %}


                            {% if service.tenure %}

                                <div>
                                    <span>Tenure</span>
                                    <strong>{{ service.tenure }}</strong>
                                </div>

                            {% endif %}


                            {% if service.collateral_required != None %}

                                <div>
                                    <span>Collateral</span>
                                    <strong>
                                        {% if service.collateral_required %}Required{% else %}Not required{% endif %}
                                    </strong>
                                </div>

                            {% endif %}


                            {% if service.government_fee != None %}

                                <div>
                                    <span>Government fee</span>
                                    <strong>₹{{ service.government_fee }}</strong>
                                </div>

                            {% endif %}


                            {% if service.bharatnxt_fee != None %}

                                <div>
                                    <span>BharatNXT fee</span>
                                    <strong>₹{{ service.bharatnxt_fee }}</strong>
                                </div>

                            {% endif %}

                        </div>


                        {% if commercial_terms %}

                            <div class="bnx-v2-commercial-list">

                                {% for item in commercial_terms %}

                                    <article>

                                        <h3>
                                            {% if item.label %}{{ item.label }}{% else %}Commercial terms{% endif %}
                                        </h3>

                                        <div class="bnx-v2-detail-grid">

                                            {% if item.minimum_charge_raw or item.minimum_charge != None %}

                                                <div>
                                                    <span>Minimum charge</span>
                                                    <strong>
                                                        {% if item.minimum_charge_raw %}{{ item.minimum_charge_raw }}{% else %}₹{{ item.minimum_charge }}{% endif %}
                                                    </strong>
                                                </div>

                                            {% endif %}


                                            {% if item.government_fee_raw or item.government_fee != None %}

                                                <div>
                                                    <span>Government fee</span>
                                                    <strong>
                                                        {% if item.government_fee_raw %}{{ item.government_fee_raw }}{% else %}₹{{ item.government_fee }}{% endif %}
                                                    </strong>
                                                </div>

                                            {% endif %}


                                            {% if item.vendor_cost_raw or item.vendor_cost != None %}

                                                <div>
                                                    <span>Vendor cost</span>
                                                    <strong>
                                                        {% if item.vendor_cost_raw %}{{ item.vendor_cost_raw }}{% else %}₹{{ item.vendor_cost }}{% endif %}
                                                    </strong>
                                                </div>

                                            {% endif %}


                                            {% if item.bdm_deduction_raw or item.bdm_deduction != None %}

                                                <div>
                                                    <span>BDM deduction</span>
                                                    <strong>
                                                        {% if item.bdm_deduction_raw %}{{ item.bdm_deduction_raw }}{% else %}₹{{ item.bdm_deduction }}{% endif %}
                                                    </strong>
                                                </div>

                                            {% endif %}

                                        </div>

                                        {% if item.remarks %}
                                            <p>{{ item.remarks|linebreaksbr }}</p>
                                        {% endif %}

                                    </article>

                                {% endfor %}

                            </div>

                        {% endif %}


                        {% if service.pricing_notes %}

                            <div class="bnx-v2-long-copy">
                                {{ service.pricing_notes|linebreaks }}
                            </div>

                        {% endif %}

                    </div>

                </details>

            {% endif %}


            {% if service.restrictions or service.important_notes or service.internal_notes or service.escalation_notes %}

                <details class="bnx-v2-disclosure">

                    <summary>

                        <span class="bnx-v2-summary-icon warning">!</span>

                        <span class="bnx-v2-summary-copy">
                            <strong>Conditions and internal notes</strong>
                            <small>Full checks before making a commitment</small>
                        </span>

                        <span class="bnx-v2-chevron" aria-hidden="true"></span>

                    </summary>


                    <div class="bnx-v2-disclosure-body">

                        {% if service.restrictions %}

                            <div class="bnx-v2-note-block warning">
                                <span>Restrictions</span>
                                {{ service.restrictions|linebreaks }}
                            </div>

                        {% endif %}


                        {% if service.important_notes %}

                            <div class="bnx-v2-note-block">
                                <span>Important notes</span>
                                {{ service.important_notes|linebreaks }}
                            </div>

                        {% endif %}


                        {% if service.internal_notes %}

                            <div class="bnx-v2-note-block">
                                <span>Internal notes</span>
                                {{ service.internal_notes|linebreaks }}
                            </div>

                        {% endif %}


                        {% if service.escalation_notes %}

                            <div class="bnx-v2-note-block warning">
                                <span>Escalation notes</span>
                                {{ service.escalation_notes|linebreaks }}
                            </div>

                        {% endif %}

                    </div>

                </details>

            {% endif %}


            {% if content_sections %}

                <details
                    class="bnx-v2-disclosure bnx-v2-source-disclosure"
                    data-bnx-source-content
                    data-bnx-deadline-recorded="{% if service.application_deadline or service.application_deadline_raw or service.deadline_status != 'UNKNOWN' %}true{% else %}false{% endif %}">

                    <summary>

                        <span class="bnx-v2-summary-icon">05</span>

                        <span class="bnx-v2-summary-copy">
                            <strong>Additional source content</strong>
                            <small data-bnx-source-count>Only details not already shown above</small>
                        </span>

                        <span class="bnx-v2-chevron" aria-hidden="true"></span>

                    </summary>


                    <div class="bnx-v2-disclosure-body">

                        <div class="bnx-v2-source-sections">

                            {% for item in content_sections %}

                                <article
                                    data-bnx-source-item
                                    data-bnx-source-type="{{ item.section_type }}">

                                    <div>

                                        {% with section_label=item.get_section_type_display %}

                                            <span>{{ section_label }}</span>

                                            {% if item.title %}

                                                {% with clean_title=item.title|cut:"Fields." %}

                                                    {% if clean_title|lower != section_label|lower %}
                                                        <h3>{{ clean_title }}</h3>
                                                    {% endif %}

                                                {% endwith %}

                                            {% endif %}

                                        {% endwith %}

                                    </div>

                                    <div class="bnx-v2-long-copy">
                                        {{ item.content|linebreaks }}
                                    </div>

                                </article>

                            {% endfor %}

                        </div>

                    </div>

                </details>


                <script id="bnx-v2-source-deduplication">
                    (function () {
                        const disclosure = document.querySelector(
                            "[data-bnx-source-content]"
                        );

                        if (!disclosure) {
                            return;
                        }

                        const normalize = function (value) {
                            return (value || "")
                                .toLocaleLowerCase()
                                .replace(/\u00a0/g, " ")
                                .replace(/[‐‑‒–—]/g, "-")
                                .replace(/\s+/g, " ")
                                .trim();
                        };

                        const structuredText = normalize(
                            Array.from(
                                document.querySelectorAll(
                                    ".bnx-v2-hero, " +
                                    ".bnx-v3-verbatim-board, " +
                                    ".bnx-v2-workspace, " +
                                    ".bnx-v2-call-checks, " +
                                    ".bnx-v2-disclosures > " +
                                    ".bnx-v2-disclosure:not([data-bnx-source-content])"
                                )
                            )
                                .map(function (node) {
                                    return node.textContent;
                                })
                                .join(" ")
                        );

                        const deadlineRecorded =
                            disclosure.dataset.bnxDeadlineRecorded === "true";

                        Array.from(
                            disclosure.querySelectorAll(
                                "[data-bnx-source-item]"
                            )
                        ).forEach(function (item) {
                            const content = item.querySelector(
                                ".bnx-v2-long-copy"
                            );

                            const sourceText = normalize(
                                content ? content.textContent : ""
                            );

                            const title = normalize(
                                item.querySelector("h3")
                                    ? item.querySelector("h3").textContent
                                    : ""
                            );

                            const isRepeatedText =
                                sourceText.length > 2 &&
                                structuredText.includes(sourceText);

                            const isRepeatedDeadline =
                                item.dataset.bnxSourceType === "TIMELINE" &&
                                deadlineRecorded &&
                                title.includes("deadline");

                            if (isRepeatedText || isRepeatedDeadline) {
                                item.hidden = true;
                            }
                        });

                        const items = Array.from(
                            disclosure.querySelectorAll(
                                "[data-bnx-source-item]:not([hidden])"
                            )
                        );

                        if (!items.length) {
                            disclosure.remove();
                            return;
                        }

                        const count = disclosure.querySelector(
                            "[data-bnx-source-count]"
                        );

                        if (count) {
                            count.textContent =
                                items.length +
                                " additional approved Toolkit " +
                                (items.length === 1 ? "section" : "sections");
                        }
                    }());
                </script>

            {% endif %}


            {% if knowledge_sections %}

                <details class="bnx-v2-disclosure">

                    <summary>

                        <span class="bnx-v2-summary-icon">06</span>

                        <span class="bnx-v2-summary-copy">
                            <strong>Knowledge</strong>
                            <small>{{ knowledge_sections|length }} supporting knowledge section{{ knowledge_sections|length|pluralize }}</small>
                        </span>

                        <span class="bnx-v2-chevron" aria-hidden="true"></span>

                    </summary>


                    <div class="bnx-v2-disclosure-body">

                        <div class="bnx-v2-source-sections">

                            {% for item in knowledge_sections %}

                                <article>

                                    <div>
                                        <span>{{ item.document.title }}</span>
                                        <h3>
                                            {% if item.title %}{{ item.title }}{% else %}{{ item.get_section_type_display }}{% endif %}
                                        </h3>
                                    </div>

                                    <div class="bnx-v2-long-copy">
                                        {{ item.content|linebreaks }}
                                    </div>

                                </article>

                            {% endfor %}

                        </div>

                    </div>

                </details>

            {% endif %}


            {% if comparison_entries %}

                <details class="bnx-v2-disclosure">

                    <summary>

                        <span class="bnx-v2-summary-icon">07</span>

                        <span class="bnx-v2-summary-copy">
                            <strong>Comparison data</strong>
                            <small>{{ comparison_entries|length }} recorded comparison entr{{ comparison_entries|length|pluralize:"y,ies" }}</small>
                        </span>

                        <span class="bnx-v2-chevron" aria-hidden="true"></span>

                    </summary>


                    <div class="bnx-v2-disclosure-body">

                        <div class="bnx-v2-comparison-grid">

                            {% for item in comparison_entries %}

                                <article>

                                    <span>
                                        {{ item.matrix.name }} · {{ item.column_name }}
                                    </span>

                                    <strong>
                                        {% if item.row_label %}{{ item.row_label }}: {% endif %}{{ item.value_raw }}
                                    </strong>

                                </article>

                            {% endfor %}

                        </div>

                    </div>

                </details>

            {% endif %}


            {% if sources %}

                <details class="bnx-v2-disclosure">

                    <summary>

                        <span class="bnx-v2-summary-icon">08</span>

                        <span class="bnx-v2-summary-copy">
                            <strong>Official and source links</strong>
                            <small>{{ sources|length }} recorded source{{ sources|length|pluralize }}</small>
                        </span>

                        <span class="bnx-v2-chevron" aria-hidden="true"></span>

                    </summary>


                    <div class="bnx-v2-disclosure-body">

                        <div class="bnx-v2-source-links">

                            {% for source in sources %}

                                {% if source.source_url %}

                                    <a
                                        href="{{ source.source_url }}"
                                        target="_blank"
                                        rel="noopener noreferrer">

                                        <div>
                                            <strong>{{ source.source_name }}</strong>
                                            <span>{{ source.get_source_kind_display }}</span>
                                        </div>

                                        <b aria-hidden="true">↗</b>

                                    </a>

                                {% endif %}

                            {% endfor %}

                        </div>

                    </div>

                </details>

            {% endif %}

        </div>

    </section>


    <footer class="bnx-v2-record-footer">

        <div>
            <span>Last updated</span>
            <strong>{{ service.updated_at|date:"d M Y" }}</strong>
        </div>

        <div>
            <span>Last verified</span>
            <strong>
                {% if service.last_verified_at %}
                    {{ service.last_verified_at|date:"d M Y" }}
                {% else %}
                    Not recorded
                {% endif %}
            </strong>
        </div>

        <p>
            Use this Toolkit record for call assistance.
            Confirm commitments against the latest official source and BharatNXT approval process.
        </p>

    </footer>

</div>

{% endblock %}
