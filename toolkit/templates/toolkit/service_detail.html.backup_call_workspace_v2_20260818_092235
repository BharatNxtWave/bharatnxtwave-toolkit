<script id="premium-toolkit-accordion-script-v11">

(function(){

    document
        .querySelectorAll(
            ".bnx-extra details"
        )
        .forEach(
            function(item){

                const summary =
                    item.querySelector(
                        ":scope > summary"
                    );


                if(!summary){
                    return;
                }


                /*
                 * Additional Toolkit sections
                 * start compact.
                 */
                item.open = false;


                let control =
                    summary.querySelector(
                        ".bnx-expand-control"
                    );


                if(!control){

                    control =
                        document.createElement(
                            "span"
                        );


                    control.className =
                        "bnx-expand-control";


                    control.innerHTML =
                        '<span '
                        + 'class="bnx-expand-control-label">'
                        + 'Click to open'
                        + '</span>'
                        + '<span '
                        + 'class="bnx-expand-control-arrow" '
                        + 'aria-hidden="true">'
                        + '⌄'
                        + '</span>';


                    summary.appendChild(
                        control
                    );
                }


                const label =
                    control.querySelector(
                        ".bnx-expand-control-label"
                    );


                function refresh(){

                    const opened =
                        item.open;


                    summary.setAttribute(
                        "aria-expanded",
                        opened
                            ? "true"
                            : "false"
                    );


                    if(label){

                        label.textContent =
                            opened
                                ? "Close"
                                : "Click to open";

                    }

                }


                item.addEventListener(
                    "toggle",
                    refresh
                );


                refresh();

            }
        );

})();

</script>



