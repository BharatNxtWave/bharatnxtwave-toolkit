<script id="bnx-service-accordion-cleanup-v1">

(function () {

    "use strict";


    /*
     * Display cleanup only.
     *
     * Imported Toolkit section names may contain:
     *
     * Fields.Focus Sectors
     * Fields.Deadline
     * Fields.Funding Organisation
     * Fields.Applicable For
     *
     * Keep stored/source data unchanged.
     * Only remove "Fields." from what the BDE sees.
     */


    function cleanSummaryLabel(summary) {

        if (!summary) {
            return;
        }


        const walker =
            document.createTreeWalker(
                summary,
                NodeFilter.SHOW_TEXT
            );


        const nodes = [];


        while (
            walker.nextNode()
        ) {

            nodes.push(
                walker.currentNode
            );
        }


        nodes.forEach(
            function (node) {

                const parent =
                    node.parentElement;


                /*
                 * Never change the existing
                 * accordion control text.
                 */
                if (
                    parent
                    &&
                    parent.closest(
                        ".bnx-expand-control"
                    )
                ) {

                    return;
                }


                const value =
                    node.nodeValue;


                if (!value) {
                    return;
                }


                /*
                 * Only remove a leading
                 * Fields. / Fields:
                 *
                 * Do NOT change normal text.
                 */
                const cleaned =
                    value.replace(
                        /^(\s*)Fields[\.:]\s*/i,
                        "$1"
                    );


                if (
                    cleaned
                    !== value
                ) {

                    node.nodeValue =
                        cleaned;
                }

            }
        );

    }


    function prepareAccordion() {

        const detailsItems =
            document.querySelectorAll(
                ".bnx-extra details"
            );


        detailsItems.forEach(
            function (details) {

                const summary =
                    details.querySelector(
                        ":scope > summary"
                    );


                if (!summary) {
                    return;
                }


                cleanSummaryLabel(
                    summary
                );


                /*
                 * Accessibility:
                 * summary already owns the interaction.
                 * The visual Open/Close pill is decorative.
                 */
                const control =
                    summary.querySelector(
                        ".bnx-expand-control"
                    );


                if (control) {

                    control.setAttribute(
                        "aria-hidden",
                        "true"
                    );

                }

            }
        );

    }


    if (
        document.readyState
        === "loading"
    ) {

        document.addEventListener(
            "DOMContentLoaded",
            prepareAccordion
        );

    }

    else {

        prepareAccordion();

    }

})();

</script>


