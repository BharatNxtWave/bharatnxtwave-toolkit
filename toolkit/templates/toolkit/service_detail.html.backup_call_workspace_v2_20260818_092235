{% extends "base.html" %}

{% block title %}
{{ service.title }} | BharatNXT Wave
{% endblock %}


{% block content %}

<style>

/* ==========================================================
   BHARATNXT SERVICE CALL WORKSPACE V1
========================================================== */

.bnx-call-page{
    max-width:1420px;
    margin:0 auto;
    padding-bottom:110px;
}

.bnx-call-topbar{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:20px;
    margin-bottom:22px;
}

.bnx-back{
    color:#475467;
    font-size:13px;
    font-weight:750;
    text-decoration:none;
}

.bnx-call-actions{
    display:flex;
    align-items:center;
    gap:9px;
    flex-wrap:wrap;
}

.bnx-call-hero{
    background:#fff;
    border:1px solid #e4e7ec;
    border-radius:22px;
    padding:28px;
    margin-bottom:14px;
}

.bnx-call-meta{
    display:flex;
    align-items:center;
    flex-wrap:wrap;
    gap:8px;
    margin-bottom:14px;
}

.bnx-call-code{
    font-size:11px;
    letter-spacing:.08em;
    font-weight:900;
    color:#667085;
}

.bnx-tag{
    background:#f2f4f7;
    border-radius:999px;
    padding:6px 9px;
    color:#344054;
    font-size:11px;
    font-weight:750;
}

.bnx-status{
    padding:6px 9px;
    border-radius:999px;
    font-size:11px;
    font-weight:850;
    background:#ecfdf3;
    color:#067647;
}

.bnx-call-hero h1{
    font-size:38px;
    line-height:1.08;
    letter-spacing:-.04em;
    margin:0;
    max-width:1050px;
}

.bnx-breadcrumb{
    color:#667085;
    font-size:12px;
    margin-top:10px;
}

.bnx-breadcrumb span{
    padding:0 5px;
    color:#d0d5dd;
}

.bnx-call-summary{
    margin:21px 0 0;
    font-size:17px;
    line-height:1.65;
    color:#344054;
    max-width:1050px;
}

.bnx-glance{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:10px;
    margin-bottom:14px;
}

.bnx-glance-card{
    background:#fff;
    border:1px solid #e4e7ec;
    border-radius:16px;
    padding:16px;
    min-height:108px;
}

.bnx-glance-card span{
    display:block;
    color:#667085;
    font-size:10px;
    font-weight:900;
    letter-spacing:.08em;
    margin-bottom:8px;
}

.bnx-glance-card strong{
    font-size:13px;
    line-height:1.5;
    color:#101828;
}

.bnx-layout{
    display:grid;
    grid-template-columns:minmax(0,1fr) 330px;
    gap:14px;
    align-items:start;
}

.bnx-main{
    display:flex;
    flex-direction:column;
    gap:12px;
}

.bnx-section{
    background:#fff;
    border:1px solid #e4e7ec;
    border-radius:18px;
    padding:22px;
    scroll-margin-top:20px;
}

.bnx-section.call-first{
    border-color:#c7d7fe;
    background:linear-gradient(
        180deg,
        #ffffff 0%,
        #fbfcff 100%
    );
}

.bnx-section-head{
    display:flex;
    gap:12px;
    align-items:flex-start;
    margin-bottom:17px;
}

.bnx-section-number{
    height:30px;
    min-width:30px;
    border-radius:9px;
    background:#f2f4f7;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:11px;
    font-weight:900;
    color:#475467;
}

.bnx-section-head small{
    display:block;
    color:#667085;
    font-size:9px;
    font-weight:900;
    letter-spacing:.1em;
    margin-bottom:3px;
}

.bnx-section-head h2{
    margin:0;
    font-size:19px;
    letter-spacing:-.02em;
}

.bnx-copy{
    color:#344054;
    font-size:14px;
    line-height:1.72;
}

.bnx-copy p:first-child{
    margin-top:0;
}

.bnx-copy p:last-child{
    margin-bottom:0;
}

.bnx-eligibility{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:8px;
    margin-top:15px;
}

.bnx-info{
    border:1px solid #eaecf0;
    background:#fafafa;
    border-radius:11px;
    padding:11px 12px;
}

.bnx-info span{
    display:block;
    color:#667085;
    font-size:10px;
    margin-bottom:4px;
}

.bnx-info strong{
    display:block;
    color:#101828;
    font-size:12px;
    line-height:1.45;
}

.bnx-rule-list{
    display:flex;
    flex-direction:column;
    gap:7px;
    margin-top:15px;
}

.bnx-rule{
    border-left:3px solid #d0d5dd;
    padding:8px 11px;
    background:#fafafa;
    border-radius:0 9px 9px 0;
}

.bnx-rule strong{
    display:block;
    font-size:12px;
    margin-bottom:3px;
}

.bnx-rule span{
    color:#475467;
    font-size:12px;
    line-height:1.5;
}

.bnx-funding-grid{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:8px;
    margin-top:14px;
}

.bnx-money{
    border-radius:12px;
    padding:13px;
    border:1px solid #eaecf0;
}

.bnx-money span{
    color:#667085;
    display:block;
    font-size:10px;
    margin-bottom:4px;
}

.bnx-money strong{
    font-size:13px;
}

.bnx-commercial-list{
    display:flex;
    flex-direction:column;
    gap:10px;
}

.bnx-commercial{
    border:1px solid #e4e7ec;
    border-radius:13px;
    overflow:hidden;
}

.bnx-commercial-head{
    background:#f9fafb;
    padding:11px 13px;
    font-size:12px;
    font-weight:850;
}

.bnx-commercial-grid{
    display:grid;
    grid-template-columns:repeat(2,1fr);
}

.bnx-commercial-item{
    padding:11px 13px;
    border-top:1px solid #f2f4f7;
}

.bnx-commercial-item:nth-child(odd){
    border-right:1px solid #f2f4f7;
}

.bnx-commercial-item span{
    display:block;
    color:#667085;
    font-size:10px;
    margin-bottom:4px;
}

.bnx-commercial-item strong{
    font-size:12px;
    line-height:1.4;
}

.bnx-commercial-note{
    padding:11px 13px;
    border-top:1px solid #f2f4f7;
    color:#475467;
    font-size:12px;
    line-height:1.55;
}

.bnx-checklist{
    display:flex;
    flex-direction:column;
    gap:8px;
}

.bnx-check{
    display:flex;
    gap:10px;
    align-items:flex-start;
    border:1px solid #eaecf0;
    border-radius:11px;
    padding:11px;
}

.bnx-check-icon{
    width:22px;
    height:22px;
    border-radius:7px;
    background:#ecfdf3;
    color:#067647;
    display:flex;
    justify-content:center;
    align-items:center;
    font-size:11px;
    font-weight:900;
    flex:none;
}

.bnx-check.optional .bnx-check-icon{
    background:#f2f4f7;
    color:#667085;
}

.bnx-check strong{
    display:block;
    font-size:12px;
}

.bnx-check small{
    display:block;
    color:#667085;
    margin-top:3px;
    line-height:1.4;
}

.bnx-process{
    position:relative;
    display:flex;
    flex-direction:column;
    gap:9px;
}

.bnx-process-item{
    display:grid;
    grid-template-columns:34px 1fr;
    gap:10px;
}

.bnx-process-number{
    height:30px;
    width:30px;
    border-radius:9px;
    background:#101828;
    color:white;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:11px;
    font-weight:900;
}

.bnx-process-copy{
    border:1px solid #eaecf0;
    border-radius:11px;
    padding:11px 12px;
}

.bnx-process-copy strong{
    font-size:12px;
}

.bnx-process-copy p{
    color:#667085;
    font-size:12px;
    margin:4px 0 0;
    line-height:1.5;
}

.bnx-process-copy small{
    color:#475467;
    display:block;
    margin-top:5px;
}

.bnx-extra{
    display:flex;
    flex-direction:column;
    gap:9px;
}

.bnx-extra details{
    border:1px solid #eaecf0;
    border-radius:11px;
    overflow:hidden;
}

.bnx-extra summary{
    cursor:pointer;
    padding:12px 13px;
    background:#fafafa;
    list-style:none;
}

.bnx-extra summary::-webkit-details-marker{
    display:none;
}

.bnx-extra-title{
    display:flex;
    justify-content:space-between;
    gap:12px;
}

.bnx-extra-title strong{
    font-size:12px;
}

.bnx-extra-title span{
    color:#667085;
    font-size:10px;
}

.bnx-extra-body{
    padding:13px;
    color:#344054;
    font-size:12px;
    line-height:1.65;
    border-top:1px solid #eaecf0;
}

.bnx-warning{
    border-color:#fedf89;
    background:#fffcf5;
}

.bnx-call-script{
    background:#f8faff;
    border-color:#c7d7fe;
}

.bnx-copy-button{
    margin-top:12px;
    border:1px solid #d0d5dd;
    background:#fff;
    border-radius:9px;
    padding:8px 11px;
    cursor:pointer;
    font-size:11px;
    font-weight:800;
}

.bnx-aside{
    position:sticky;
    top:18px;
    display:flex;
    flex-direction:column;
    gap:10px;
}

.bnx-side-card{
    background:#fff;
    border:1px solid #e4e7ec;
    border-radius:15px;
    padding:15px;
}

.bnx-side-kicker{
    color:#667085;
    font-size:9px;
    font-weight:900;
    letter-spacing:.1em;
    margin-bottom:11px;
}

.bnx-side-fact{
    display:flex;
    justify-content:space-between;
    gap:12px;
    padding:9px 0;
    border-bottom:1px solid #f2f4f7;
}

.bnx-side-fact:last-child{
    border-bottom:0;
}

.bnx-side-fact span{
    color:#667085;
    font-size:11px;
}

.bnx-side-fact strong{
    font-size:11px;
    text-align:right;
    max-width:170px;
}

.bnx-side-nav{
    display:flex;
    flex-direction:column;
    gap:3px;
}

.bnx-side-nav a{
    text-decoration:none;
    color:#475467;
    font-size:11px;
    padding:7px 8px;
    border-radius:8px;
}

.bnx-side-nav a:hover{
    background:#f2f4f7;
    color:#101828;
}

.bnx-source-list{
    display:flex;
    flex-direction:column;
    gap:6px;
}

.bnx-source{
    display:flex;
    justify-content:space-between;
    gap:8px;
    text-decoration:none;
    color:#101828;
    border:1px solid #eaecf0;
    border-radius:9px;
    padding:9px;
}

.bnx-source strong{
    display:block;
    font-size:11px;
}

.bnx-source span{
    display:block;
    color:#667085;
    font-size:9px;
    margin-top:3px;
}

.bnx-muted{
    color:#98a2b3;
    font-size:12px;
}

.bnx-sticky{
    position:fixed;
    bottom:14px;
    left:50%;
    transform:translateX(-50%);
    width:min(880px,calc(100% - 40px));
    z-index:50;
    background:rgba(255,255,255,.96);
    backdrop-filter:blur(10px);
    border:1px solid #d0d5dd;
    box-shadow:0 12px 32px rgba(16,24,40,.12);
    border-radius:16px;
    padding:9px 10px 9px 14px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:12px;
}

.bnx-sticky strong{
    display:block;
    font-size:11px;
}

.bnx-sticky span{
    color:#667085;
    font-size:10px;
}

.bnx-sticky-actions{
    display:flex;
    gap:7px;
}

@media(max-width:1050px){

    .bnx-layout{
        grid-template-columns:1fr;
    }

    .bnx-aside{
        position:static;
    }

}

@media(max-width:760px){

    .bnx-call-hero h1{
        font-size:29px;
    }

    .bnx-glance{
        grid-template-columns:repeat(2,1fr);
    }

    .bnx-eligibility,
    .bnx-funding-grid,
    .bnx-commercial-grid{
        grid-template-columns:1fr;
    }

    .bnx-commercial-item:nth-child(odd){
        border-right:0;
    }

    .bnx-call-topbar{
        align-items:flex-start;
        flex-direction:column;
    }

}

</style>


<div class="bnx-call-page">


    <!-- ====================================================
         TOP ACTIONS
    ===================================================== -->

    <div class="bnx-call-topbar">

        <a
            href="{% url 'toolkit:service_library' %}"
            class="bnx-back">
            ← Service Library
        </a>


        <div class="bnx-call-actions">

            <form
                method="post"
                action="{% url 'toolkit:toggle_saved_service' service.pk %}"
                class="bde-ajax-save">

                {% csrf_token %}

                <input
                    type="hidden"
                    name="next"
                    value="{{ request.path }}">

                <button
                    type="submit"
                    class="secondary-button bde-save-text {% if is_saved %}saved{% endif %}">

                    {% if is_saved %}
                        <span class="bn-bookmark-icon is-saved" aria-hidden="true"></span> Saved
                    {% else %}
                        <span class="bn-bookmark-icon" aria-hidden="true"></span> Save
                    {% endif %}

                </button>

            </form>


            {% if primary_source and primary_source.source_url %}

                <a
                    href="{{ primary_source.source_url }}"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="bde-external-button">

                    Open Scheme ↗

                </a>

            {% endif %}

        </div>

    </div>


    <!-- ====================================================
         HERO
    ===================================================== -->

    <header class="bnx-call-hero">

        <div class="bnx-call-meta">

            <span class="bnx-call-code">
                {{ service.service_id }}
            </span>

            <span class="bnx-tag">
                {{ service.get_service_kind_display }}
            </span>

            <span class="bnx-status">
                {{ service.pitch_state_label }}
            </span>

        </div>


        <h1>
            {{ service.title }}
        </h1>


        <div class="bnx-breadcrumb">

            {{ service.domain.name }}

            <span>›</span>

            {{ service.category.name }}

            {% for item in classification_categories %}

                {% if item.pk != service.category_id %}

                    <span>›</span>
                    {{ item.name }}

                {% endif %}

            {% endfor %}

        </div>


        {% if service.bde_summary %}

            <p class="bnx-call-summary">
                {{ service.bde_summary }}
            </p>

        {% elif service.overview %}

            <p class="bnx-call-summary">
                {{ service.overview|truncatechars:450 }}
            </p>

        {% endif %}

    </header>


    <!-- ====================================================
         CALL AT-A-GLANCE
    ===================================================== -->

    <section class="bnx-glance">

        <div class="bnx-glance-card">

            <span>CLIENT BENEFIT</span>

            <strong>

                {% if service.benefits %}
                    {{ service.benefits|truncatechars:125 }}
                {% else %}
                    Check detailed Toolkit information below
                {% endif %}

            </strong>

        </div>


        <div class="bnx-glance-card">

            <span>DEADLINE</span>

            <strong>
                {{ service.bde_deadline_label }}
            </strong>

        </div>


        <div class="bnx-glance-card">

            <span>APPLICABLE FOR</span>

            <strong>

                {% if service.applicable_for_raw %}

                    {{ service.applicable_for_raw|truncatechars:125 }}

                {% elif service.business_types %}

                    {{ service.business_types|join:", " }}

                {% else %}

                    Check eligibility below

                {% endif %}

            </strong>

        </div>


        <div class="bnx-glance-card">

            <span>ORGANISATION / TYPE</span>

            <strong>

                {% if service.funding_organisation %}

                    {{ service.funding_organisation }}

                {% elif service.funding_type %}

                    {{ service.funding_type }}

                {% else %}

                    {{ service.get_service_kind_display }}

                {% endif %}

            </strong>

        </div>

    </section>


    <div class="bnx-layout">


        <!-- =================================================
             MAIN CALL WORKSPACE
        ================================================== -->

        <main class="bnx-main">


            <!-- CALL SUMMARY -->

            <section
                class="bnx-section call-first"
                id="call-summary">

                <div class="bnx-section-head">

                    <span class="bnx-section-number">
                        01
                    </span>

                    <div>
                        <small>CALL FIRST</small>
                        <h2>What this does</h2>
                    </div>

                </div>


                <div class="bnx-copy">

                    {% if service.overview %}

                        {{ service.overview|linebreaks }}

                    {% elif service.bde_summary %}

                        {{ service.bde_summary|linebreaks }}

                    {% else %}

                        <p class="bnx-muted">
                            No separate overview is recorded.
                            Continue with the Toolkit information below.
                        </p>

                    {% endif %}

                </div>

            </section>


            <!-- ELIGIBILITY -->

            <section
                class="bnx-section"
                id="eligibility">

                <div class="bnx-section-head">

                    <span class="bnx-section-number">
                        02
                    </span>

                    <div>
                        <small>WHO CAN APPLY</small>
                        <h2>Eligibility</h2>
                    </div>

                </div>


                {% if service.eligibility_summary %}

                    <div class="bnx-copy">
                        {{ service.eligibility_summary|linebreaks }}
                    </div>

                {% endif %}


                <div class="bnx-eligibility">

                    {% if service.business_types %}

                        <div class="bnx-info">
                            <span>Entity type</span>
                            <strong>
                                {{ service.business_types|join:", " }}
                            </strong>
                        </div>

                    {% endif %}


                    {% if service.business_stages %}

                        <div class="bnx-info">
                            <span>Business stage</span>
                            <strong>
                                {{ service.business_stages|join:", " }}
                            </strong>
                        </div>

                    {% endif %}


                    {% if service.industries %}

                        <div class="bnx-info">
                            <span>Industry / Sector</span>
                            <strong>
                                {{ service.industries|join:", " }}
                            </strong>
                        </div>

                    {% endif %}


                    {% if service.applicable_states %}

                        <div class="bnx-info">
                            <span>Location</span>
                            <strong>
                                {{ service.applicable_states|join:", " }}
                            </strong>
                        </div>

                    {% endif %}


                    {% if service.founder_categories %}

                        <div class="bnx-info">
                            <span>Founder category</span>
                            <strong>
                                {{ service.founder_categories|join:", " }}
                            </strong>
                        </div>

                    {% endif %}


                    {% if service.applicable_for_raw %}

                        <div class="bnx-info">
                            <span>Toolkit wording</span>
                            <strong>
                                {{ service.applicable_for_raw }}
                            </strong>
                        </div>

                    {% endif %}


                    {% if service.min_business_age_months != None %}

                        <div class="bnx-info">
                            <span>Minimum business age</span>
                            <strong>
                                {{ service.min_business_age_months }}
                                months
                            </strong>
                        </div>

                    {% endif %}


                    {% if service.max_business_age_months != None %}

                        <div class="bnx-info">
                            <span>Maximum business age</span>
                            <strong>
                                {{ service.max_business_age_months }}
                                months
                            </strong>
                        </div>

                    {% endif %}


                    {% if service.min_turnover != None %}

                        <div class="bnx-info">
                            <span>Minimum turnover</span>
                            <strong>
                                ₹{{ service.min_turnover }}
                            </strong>
                        </div>

                    {% endif %}


                    {% if service.max_turnover != None %}

                        <div class="bnx-info">
                            <span>Maximum turnover</span>
                            <strong>
                                ₹{{ service.max_turnover }}
                            </strong>
                        </div>

                    {% endif %}

                </div>


                {% if eligibility_rules %}

                    <div class="bnx-rule-list">

                        {% for rule in eligibility_rules %}

                            <div class="bnx-rule">

                                <strong>
                                    {{ rule.title }}
                                </strong>

                                <span>
                                    {{ rule.description }}
                                </span>

                            </div>

                        {% endfor %}

                    </div>

                {% elif not service.eligibility_summary and not service.applicable_for_raw %}

                    <p class="bnx-muted">
                        No additional eligibility wording
                        is recorded for this Service.
                    </p>

                {% endif %}

            </section>


            <!-- BENEFITS & FUNDING -->

            <section
                class="bnx-section"
                id="benefits">

                <div class="bnx-section-head">

                    <span class="bnx-section-number">
                        03
                    </span>

                    <div>
                        <small>VALUE FOR CLIENT</small>
                        <h2>Benefits & funding</h2>
                    </div>

                </div>


                <div class="bnx-copy">

                    {% if service.benefits %}

                        {{ service.benefits|linebreaks }}

                    {% else %}

                        <p class="bnx-muted">
                            No separate benefits summary is recorded.
                        </p>

                    {% endif %}

                </div>


                {% if service.funding_type or service.funding_min != None or service.funding_max != None or service.interest_rate_min != None or service.interest_rate_max != None or service.tenure or service.subsidy_details %}

                <div class="bnx-funding-grid">


                    {% if service.funding_type %}

                        <div class="bnx-money">
                            <span>Funding type</span>
                            <strong>
                                {{ service.funding_type }}
                            </strong>
                        </div>

                    {% endif %}


                    {% if service.funding_min != None or service.funding_max != None %}

                        <div class="bnx-money">

                            <span>Funding range</span>

                            <strong>

                                {% if service.funding_min != None %}
                                    ₹{{ service.funding_min }}
                                {% endif %}

                                {% if service.funding_min != None and service.funding_max != None %}
                                    –
                                {% endif %}

                                {% if service.funding_max != None %}
                                    ₹{{ service.funding_max }}
                                {% endif %}

                            </strong>

                        </div>

                    {% endif %}


                    {% if service.interest_rate_min != None or service.interest_rate_max != None %}

