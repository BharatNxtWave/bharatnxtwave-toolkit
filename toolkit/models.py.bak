from django.db import models


class Category(models.Model):
    name = models.CharField(max_length=120, unique=True)
    slug = models.SlugField(max_length=140, unique=True)
    description = models.TextField(blank=True)

    is_active = models.BooleanField(default=True)

    created_at = models.DateTimeField(auto_now_add=True)
    updated_at = models.DateTimeField(auto_now=True)

    class Meta:
        verbose_name_plural = "Categories"
        ordering = ["name"]

    def __str__(self):
        return self.name


class Service(models.Model):
    STATUS_CHOICES = [
        ("DRAFT", "Draft"),
        ("UNDER_REVIEW", "Under Review"),
        ("APPROVED", "Approved"),
        ("PUBLISHED", "Published"),
        ("EXPIRING", "Expiring"),
        ("ARCHIVED", "Archived"),
    ]

    SERVICE_TYPE_CHOICES = [
        ("GRANT", "Grant"),
        ("FUNDING", "Funding"),
        ("VC", "VC Funding"),
        ("LOAN", "Loan"),
        ("MSME", "MSME"),
        ("STARTUP", "Startup"),
        ("GOVT_SCHEME", "Government Scheme"),
        ("SUBSIDY", "Subsidy"),
        ("REGISTRATION", "Registration"),
        ("COMPLIANCE", "Compliance"),
        ("OTHER", "Other"),
    ]

    service_id = models.CharField(
        max_length=30,
        unique=True
    )

    title = models.CharField(
        max_length=255
    )

    short_description = models.TextField(
        blank=True
    )

    category = models.ForeignKey(
        Category,
        on_delete=models.PROTECT,
        related_name="services"
    )

    service_type = models.CharField(
        max_length=30,
        choices=SERVICE_TYPE_CHOICES
    )

    status = models.CharField(
        max_length=30,
        choices=STATUS_CHOICES,
        default="DRAFT"
    )

    eligibility = models.TextField(
        blank=True
    )

    benefits = models.TextField(
        blank=True
    )

    restrictions = models.TextField(
        blank=True
    )

    required_documents = models.TextField(
        blank=True
    )

    application_process = models.TextField(
        blank=True
    )

    funding_min = models.DecimalField(
        max_digits=14,
        decimal_places=2,
        null=True,
        blank=True
    )

    funding_max = models.DecimalField(
        max_digits=14,
        decimal_places=2,
        null=True,
        blank=True
    )

    funding_type = models.CharField(
        max_length=100,
        blank=True
    )

    interest_rate = models.DecimalField(
        max_digits=6,
        decimal_places=2,
        null=True,
        blank=True
    )

    collateral_required = models.BooleanField(
        null=True,
        blank=True
    )

    tenure = models.CharField(
        max_length=120,
        blank=True
    )

    source_name = models.CharField(
        max_length=255,
        blank=True
    )

    source_url = models.URLField(
        blank=True
    )

    internal_notes = models.TextField(
        blank=True
    )

    version = models.PositiveIntegerField(
        default=1
    )

    last_verified_at = models.DateTimeField(
        null=True,
        blank=True
    )

    verified_by = models.ForeignKey(
        "accounts.User",
        on_delete=models.SET_NULL,
        null=True,
        blank=True,
        related_name="verified_services"
    )

    created_at = models.DateTimeField(
        auto_now_add=True
    )

    updated_at = models.DateTimeField(
        auto_now=True
    )

    class Meta:
        ordering = ["title"]

    def __str__(self):
        return f"{self.service_id} - {self.title}"