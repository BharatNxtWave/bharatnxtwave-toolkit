# BharatNXT Wave production environment template
# Never store the real production values in Git.

BHARATNXT_ENVIRONMENT=production

BHARATNXT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Internal server host/IP only.
BHARATNXT_ALLOWED_HOSTS=192.168.1.50

# Example only. Replace with the actual internal HTTPS address.
BHARATNXT_CSRF_TRUSTED_ORIGINS=https://192.168.1.50

# Replace this with the real BharatNXT office LAN subnet.
BHARATNXT_OFFICE_NETWORKS=192.168.1.0/24


# PostgreSQL
BHARATNXT_DB_ENGINE=postgresql
BHARATNXT_DB_NAME=bharatnxt_toolkit
BHARATNXT_DB_USER=bharatnxt_app
BHARATNXT_DB_PASSWORD=REPLACE_WITH_STRONG_DATABASE_PASSWORD
BHARATNXT_DB_HOST=127.0.0.1
BHARATNXT_DB_PORT=5432


# Local Nginx reverse proxy.
BHARATNXT_TRUSTED_PROXIES=127.0.0.1,::1
