server {
    listen 443 ssl;
    server_name 192.168.1.50;

    # Replace these with the internal certificate paths.
    ssl_certificate     /etc/ssl/certs/bharatnxt-internal.crt;
    ssl_certificate_key /etc/ssl/private/bharatnxt-internal.key;

    client_max_body_size 20M;

    location /static/ {
        alias /opt/bharatnxt-toolkit/staticfiles/;
        access_log off;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;

        proxy_connect_timeout 30;
        proxy_read_timeout 60;
    }
}


server {
    listen 80;
    server_name 192.168.1.50;

    return 301 https://$host$request_uri;
}
