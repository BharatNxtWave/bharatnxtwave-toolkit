<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>{% block title %}BharatNXT Wave Internal{% endblock %}</title>

    <link rel="stylesheet" href="{% static 'css/app.css' %}?v=20260818_shell_recovery_v1">
<link rel="stylesheet" href="{% static 'css/ui_stability.css' %}?v=20260818_shell_recovery_v1">
    <link rel="stylesheet" href="{% static 'css/bde_workspace.css' %}?v=20260818_shell_recovery_v1">

<style id="premium-bde-sidebar-v11">

/* =========================================================
   COLLAPSIBLE BDE SIDEBAR
========================================================= */

.sidebar{
    transition:
        width .22s ease,
        padding .22s ease;
}


.main-area{
    transition:
        margin-left .22s ease;
}


.bnx-sidebar-toggle{

    position:absolute;

    top:30px;
    right:-14px;

    width:30px;
    height:30px;

    padding:0;

    display:flex;
    align-items:center;
    justify-content:center;

    border:1px solid #d0d5dd;
    border-radius:50%;

    background:#ffffff;
    color:#475467;

    cursor:pointer;

    box-shadow:
        0 4px 12px
        rgba(16,24,40,.13);

    z-index:200;

    transition:
        color .15s ease,
        background .15s ease,
        transform .15s ease;
}


.bnx-sidebar-toggle:hover{

    color:#1769ff;

    background:#f8faff;
}


.bnx-sidebar-toggle svg{

    width:14px;
    height:14px;

    fill:none;
    stroke:currentColor;
    stroke-width:2;

    transition:
        transform .20s ease;
}


/* =========================================================
   COMPACT MODE
========================================================= */

body.bnx-sidebar-collapsed
.sidebar{

    width:78px !important;

    padding-left:10px !important;
    padding-right:10px !important;
}


body.bnx-sidebar-collapsed
.main-area{

    margin-left:78px !important;
}


body.bnx-sidebar-collapsed
.brand{

    justify-content:center !important;

    padding-left:0 !important;
    padding-right:0 !important;
}


body.bnx-sidebar-collapsed
.brand-text,

body.bnx-sidebar-collapsed
.nav-section-label{

    display:none !important;
}


body.bnx-sidebar-collapsed
.navigation{

    gap:7px !important;
}


body.bnx-sidebar-collapsed
.nav-item{

    position:relative;

    width:48px !important;
    height:46px !important;

    margin-left:auto !important;
    margin-right:auto !important;

    padding:0 !important;

    display:flex !important;

    align-items:center !important;
    justify-content:center !important;

    border-radius:12px !important;
}


body.bnx-sidebar-collapsed
.nav-item > span:not(.nav-icon){

    display:none !important;
}


body.bnx-sidebar-collapsed
.nav-item .nav-icon{

    width:22px !important;

    margin:0 !important;

    display:flex !important;

    align-items:center !important;
    justify-content:center !important;
}


body.bnx-sidebar-collapsed
.sidebar-account-actions{

    display:flex !important;

    justify-content:center !important;
}


body.bnx-sidebar-collapsed
.sidebar-logout-button{

    width:48px !important;

    padding-left:0 !important;
    padding-right:0 !important;

    justify-content:center !important;
}


body.bnx-sidebar-collapsed
.sidebar-logout-button > span:last-child{

    display:none !important;
}


body.bnx-sidebar-collapsed
.bnx-sidebar-toggle svg{

    transform:
        rotate(180deg);
}


/* HOVER TOOLTIP */

body.bnx-sidebar-collapsed
.nav-item:hover::after{

    content:
        attr(data-bnx-label);

    position:absolute;

    left:59px;
    top:50%;

    transform:
        translateY(-50%);

    padding:7px 10px;

    border-radius:8px;

    background:#101828;
    color:#ffffff;

    white-space:nowrap;

    font-size:11px;
    font-weight:650;

    box-shadow:
        0 7px 18px
        rgba(16,24,40,.18);

    z-index:500;
}


@media(max-width:760px){

    .bnx-sidebar-toggle{
        display:none;
    }

}

</style>



<!-- SIDEBAR_TOGGLE_VISIBILITY_V12 -->

<style id="sidebar-toggle-visibility-v12">

.bnx-sidebar-toggle{

    width:36px !important;
    height:36px !important;

    top:27px !important;
    right:-18px !important;

    border:
        3px solid #ffffff !important;

    border-radius:
        11px !important;

    background:
        #1769ff !important;

    color:
        #ffffff !important;

    box-shadow:
        0 5px 16px
        rgba(23,105,255,.32),
        0 2px 6px
        rgba(16,24,40,.18) !important;

    opacity:1 !important;

    visibility:visible !important;

    overflow:visible !important;
}


.bnx-sidebar-toggle:hover{

    background:
        #0f5de8 !important;

    color:
        #ffffff !important;

    transform:
        scale(1.06);

    box-shadow:
        0 7px 20px
        rgba(23,105,255,.38),
        0 3px 8px
        rgba(16,24,40,.20) !important;
}


.bnx-sidebar-toggle:active{

    transform:
        scale(.96);
}


.bnx-sidebar-toggle-icon{

    width:20px !important;
    height:20px !important;

    fill:none !important;

    stroke:
        currentColor !important;

    stroke-width:
        1.8 !important;

    stroke-linecap:
        round !important;

    stroke-linejoin:
        round !important;

    transition:
        transform .2s ease;
}


/*
When sidebar is collapsed,
the entire panel icon reverses direction.
*/

body.bnx-sidebar-collapsed
.bnx-sidebar-toggle-icon{

    transform:
        rotate(180deg);
}


/*
Cancel old V1.1 rotation rule
so the icon only rotates once.
*/

body.bnx-sidebar-collapsed
.bnx-sidebar-toggle svg{

    transform:
        none !important;
}


.bnx-sidebar-toggle:focus-visible{

    outline:
        3px solid
        rgba(23,105,255,.25);

    outline-offset:
        3px;
}

</style>



<!-- SIDEBAR_TOGGLE_FINAL_FIX -->

<style id="bnx-sidebar-toggle-final-fix">

/* =========================================================
   FINAL SIDEBAR TOGGLE
   Completely inside sidebar — nothing can clip it
========================================================= */

.sidebar{
    overflow:visible !important;
}


/*
Expanded sidebar:
place control inside the black sidebar,
not across the white-content boundary.
*/

#bnx-sidebar-toggle{

    position:absolute !important;

    top:96px !important;
    right:16px !important;

    left:auto !important;

    width:34px !important;
    height:34px !important;

    min-width:34px !important;
    min-height:34px !important;

    margin:0 !important;
    padding:0 !important;

    display:flex !important;
    align-items:center !important;
    justify-content:center !important;

    border:
        1px solid
        rgba(255,255,255,.16) !important;

    border-radius:
        10px !important;

    background:
        #20242c !important;

    color:
        #ffffff !important;

    box-shadow:
        none !important;

    opacity:1 !important;
    visibility:visible !important;

    overflow:hidden !important;

    cursor:pointer !important;

    z-index:9999 !important;

    transform:none !important;

    transition:
        background .16s ease,
        border-color .16s ease,
        transform .16s ease !important;
}


#bnx-sidebar-toggle:hover{

    background:
        #1769ff !important;

    border-color:
        #1769ff !important;

    color:
        #ffffff !important;

    transform:
        translateY(-1px) !important;

    box-shadow:
        none !important;
}


#bnx-sidebar-toggle:active{

    transform:
        scale(.95) !important;
}


/* =========================================================
   REMOVE EVERY OLD SVG EFFECT
========================================================= */

#bnx-sidebar-toggle svg{

    display:none !important;

    width:0 !important;
    height:0 !important;

    transform:none !important;
}


/* =========================================================
   CRISP NON-SVG CHEVRON
========================================================= */

.bnx-sidebar-final-chevron{

    position:relative;

    width:16px;
    height:16px;

    display:block;

    flex:none;
}


.bnx-sidebar-final-chevron::before,
.bnx-sidebar-final-chevron::after{

    content:"";

    position:absolute;

    left:5px;

    width:8px;
    height:2px;

    background:
        currentColor;

    border-radius:
        999px;

    transform-origin:
        1px center;
}


.bnx-sidebar-final-chevron::before{

    top:5px;

    transform:
        rotate(-45deg);
}


.bnx-sidebar-final-chevron::after{

    bottom:5px;

    transform:
        rotate(45deg);
}


/* =========================================================
   COLLAPSED SIDEBAR
========================================================= */

body.bnx-sidebar-collapsed
#bnx-sidebar-toggle{

    top:96px !important;
    right:22px !important;

    width:34px !important;
    height:34px !important;

    transform:none !important;
}


/*
Reverse the chevron when sidebar
is collapsed so it means "expand".
*/

body.bnx-sidebar-collapsed
.bnx-sidebar-final-chevron{

    transform:
        rotate(180deg);
}


body.bnx-sidebar-collapsed
#bnx-sidebar-toggle:hover{

    transform:
        translateY(-1px) !important;
}


/* =========================================================
   FOCUS
========================================================= */

#bnx-sidebar-toggle:focus-visible{

    outline:
        3px solid
        rgba(23,105,255,.30) !important;

    outline-offset:
        3px !important;
}


/* =========================================================
   MOBILE
========================================================= */

@media(max-width:760px){

    #bnx-sidebar-toggle{
        display:none !important;
    }

}

</style>



<!-- SIMPLE_SIDEBAR_ARROW_FINAL -->

<style id="simple-sidebar-arrow-final">

/* =========================================================
   SIMPLE SIDEBAR TOGGLE
========================================================= */

#bnx-sidebar-toggle{

    width:34px !important;
    height:34px !important;

    border:
        1px solid
        #3a414c !important;

    border-radius:
        9px !important;

