    transform:none !important;

    font-size:
        27px !important;

    font-weight:
        300 !important;

    line-height:
        28px !important;

    color:
        #ffffff !important;
}


/* collapsed = simple right arrow */

body.bnx-sidebar-collapsed
.bnx-sidebar-final-chevron{

    transform:none !important;
}


body.bnx-sidebar-collapsed
.bnx-sidebar-final-chevron::after{

    content:"›" !important;

    transform:none !important;
}


/* no old SVG */

#bnx-sidebar-toggle svg{

    display:none !important;
}

</style>



<style id="BNX_GLOBAL_SHELL_RECOVERY_V1">

/* =========================================================
   GLOBAL SOFTWARE SHELL RECOVERY

   The application's intended architecture is:

   FIXED SIDEBAR
   +
   MAIN AREA BESIDE IT

   Do not change sidebar widths here.
   Existing expanded/collapsed width rules remain authoritative.
========================================================= */


/* ---------------------------------------------------------
   SIDEBAR MUST NEVER ENTER NORMAL DOCUMENT FLOW
--------------------------------------------------------- */

.sidebar,
body.bnx-sidebar-collapsed .sidebar {

    position:
        fixed !important;

    top:
        0 !important;

    left:
        0 !important;

    bottom:
        0 !important;

    margin-top:
        0 !important;

    margin-bottom:
        0 !important;

}


/* ---------------------------------------------------------
   MAIN APPLICATION MUST START AT TOP OF VIEWPORT
--------------------------------------------------------- */

.main-area,
body.bnx-sidebar-collapsed .main-area {

    margin-top:
        0 !important;

    min-height:
        100vh !important;

}


/* ---------------------------------------------------------
   SHARED APPLICATION SHELL
--------------------------------------------------------- */

.app-shell {

    min-height:
        100vh !important;

}


/* ---------------------------------------------------------
   TOPBAR MUST REMAIN AT TOP OF MAIN AREA
--------------------------------------------------------- */

.main-area > .topbar {

    top:
        0 !important;

    margin-top:
        0 !important;

}


/* ---------------------------------------------------------
   BDE VARIANTS USE THE SAME GEOMETRY
--------------------------------------------------------- */

.bde-sidebar,
body.bnx-sidebar-collapsed .bde-sidebar {

    position:
        fixed !important;

    top:
        0 !important;

    left:
        0 !important;

    bottom:
        0 !important;

}


.bde-main-area,
body.bnx-sidebar-collapsed .bde-main-area {

    margin-top:
        0 !important;

    min-height:
        100vh !important;

}

</style>



<link rel="stylesheet" href="{% static 'css/saved_collections.css' %}?v=20260818_v11">
</head>

<body>

<div class="app-shell bde-shell">

    <!-- SIDEBAR -->
    <aside class="sidebar bde-sidebar">

<!-- PREMIUM_BDE_SIDEBAR_V11 -->
<button
    type="button"
    id="bnx-sidebar-toggle"
    class="bnx-sidebar-toggle"
    aria-label="Collapse sidebar"
    aria-expanded="true"
    title="Collapse sidebar">
    <span
        class="bnx-sidebar-final-chevron"
        aria-hidden="true">
    </span>
</button>


        <!-- BRAND -->
        <div class="brand">

            <div class="brand-mark">
                BN
            </div>

            <div class="brand-text">
                <div class="brand-name">
                    BharatNXT Wave
                </div>

                <div class="brand-subtitle">
                    INTERNAL
                </div>
            </div>

        </div>


        <!-- MAIN NAVIGATION -->
        <nav class="navigation bde-navigation">

            <div class="nav-section-label">
                WORKSPACE
            </div>

            <a href="{% url 'dashboard:home' %}"
               class="nav-item {% if request.path == '/' %}active{% endif %}">
                <span class="nav-icon">⌂</span>
                <span>Home</span>
            </a>

            <a href="{% url 'toolkit:home' %}"
               class="nav-item {% if request.path == '/toolkit/' or '/toolkit/service/' in request.path %}active{% endif %}">
                <span class="nav-icon">◫</span>
                <span>Business Toolkit</span>
            </a>

            
            <a href="{% url 'toolkit:service_library' %}"
               class="nav-item {% if '/toolkit/library/' in request.path %}active{% endif %}">
                <span class="nav-icon">▦</span>
                <span>Service Library</span>
            </a>

            <a href="{% url 'toolkit:recent_services' %}"
               class="nav-item {% if '/toolkit/recent/' in request.path %}active{% endif %}">
                <span class="nav-icon">◷</span>
                <span>Recent</span>
            </a>

<a href="{% url 'toolkit:saved_services' %}"
               class="nav-item {% if '/toolkit/saved/' in request.path %}active{% endif %}">
                <span class="nav-icon"><span class="bn-bookmark-icon" aria-hidden="true"></span></span>
                <span>Saved Services</span>
            </a>

            <a
                href="{% url 'toolkit:client_matcher' %}"
                class="nav-item {% if '/toolkit/matcher/' in request.path %}active{% endif %}">

                
                <span
                    class="nav-icon bn-nav-svg-wrap"
                    aria-hidden="true">

                    <svg
                        class="bn-nav-svg"
                        viewBox="0 0 24 24"
                        fill="none">

                        <circle
                            cx="8"
                            cy="7"
                            r="3">
                        </circle>

                        <path
                            d="M3.5 16.5C4.1 13.8 5.7 12.5 8 12.5C9.2 12.5 10.2 12.8 11 13.4">
                        </path>

                        <circle
                            cx="16.5"
                            cy="15.5"
                            r="4">
                        </circle>

                        <path
                            d="M19.5 18.5L22 21">
                        </path>

                    </svg>

                </span>

                <span>
                    Find Services for Client
                </span>


            </a>


        </nav>

    
    <!-- SIDEBAR ACCOUNT ACTIONS -->
    <div class="sidebar-account-actions">

        <form
            method="post"
            action="{% url 'accounts:logout' %}"
            class="sidebar-logout-form">

            {% csrf_token %}

            <button
                type="submit"
                class="sidebar-logout-button">

                <span
                    class="sidebar-logout-icon"
                    aria-hidden="true">

                    <svg
                        viewBox="0 0 24 24"
                        fill="none">

                        <path
                            d="M10 5H6.5C5.7 5 5 5.7 5 6.5V17.5C5 18.3 5.7 19 6.5 19H10">
                        </path>

                        <path
                            d="M14 8L18 12L14 16">
                        </path>

                        <path
                            d="M18 12H9">
                        </path>

                    </svg>

                </span>

                <span>
                    Sign Out
                </span>

            </button>

        </form>

    </div>

</aside>


    <!-- MAIN APPLICATION AREA -->
    <main class="main-area bde-main-area">


        <!-- TOP NAVIGATION BAR -->
        <header class="topbar bde-topbar">


            <!-- GLOBAL SEARCH -->


            <!-- TOP RIGHT -->
            <div class="topbar-actions">

                <!-- USER PROFILE -->
                <div class="user-profile">

                    <div class="user-avatar">

                        {{ request.user.username|slice:":1"|upper }}

                    </div>


                    <div class="user-info">

                        <div class="user-name">

                            {{ request.user.username }}

                        </div>

                        <div class="user-role">

                            {{ request.user.get_role_display }}

                        </div>

                    </div>

                </div>

            </div>

        
            

</header>


        <!-- MAIN PAGE CONTENT -->
        
        <!-- =================================================
             GLOBAL HUMAN FEEDBACK
        ================================================== -->

        {% if messages %}

            <div
                class="bn-feedback-stack"
                aria-live="polite"
                aria-atomic="true">

                {% for message in messages %}

                    <div
                        class="bn-feedback-toast {{ message.tags|default:'info' }}"
                        data-feedback-type="{{ message.tags|default:'info' }}"
                        role="status">


                        <div
                            class="bn-feedback-icon"
                            aria-hidden="true">

                            {% if "success" in message.tags %}
                                ✓
                            {% elif "error" in message.tags %}
                                !
                            {% elif "warning" in message.tags %}
                                !
                            {% else %}
                                i
                            {% endif %}

                        </div>


                        <div class="bn-feedback-copy">

                            {% if "success" in message.tags %}

                                <strong>
                                    Done
                                </strong>

                            {% elif "error" in message.tags %}

                                <strong>
                                    Something went wrong
                                </strong>

                            {% elif "warning" in message.tags %}

                                <strong>
                                    Please check
                                </strong>

                            {% else %}

                                <strong>
                                    Update
                                </strong>

                            {% endif %}


                            <span>
                                {{ message }}
                            </span>

                        </div>


                        <button
                            type="button"
                            class="bn-feedback-close"
                            aria-label="Dismiss notification">

                            ×

                        </button>

                    </div>

                {% endfor %}

            </div>

        {% endif %}


<section class="content bde-content">

            {% block content %}

            {% endblock %}

        </section>


    </main>

</div>

    <script src="{% static 'js/session_location.js' %}"></script>


    <script src="{% static 'js/ui_feedback.js' %}"></script>


<div id="bde-quick-overlay"
     class="bde-quick-overlay"
     hidden></div>

<aside id="bde-quick-drawer"
       class="bde-quick-drawer"
       aria-label="Service quick view"
       hidden>
    <div class="bde-quick-drawer-header">
        <div>
            <span>CALL ASSIST</span>
            <strong>Service quick view</strong>
        </div>
        <button id="bde-quick-close"
                type="button"
                aria-label="Close quick view">×</button>
    </div>
    <div id="bde-quick-drawer-content"
         class="bde-quick-drawer-content">
        <div class="bde-quick-loading">Loading service…</div>
    </div>
</aside>

    <script src="{% static 'js/bde_workspace.js' %}"></script>

<script id="premium-bde-sidebar-script-v11">

(function(){

    const toggle =
        document.getElementById(
            "bnx-sidebar-toggle"
        );

    if(!toggle){
        return;
    }


    const storageKey =
        "bharatnxt_bde_sidebar_collapsed";


    document
        .querySelectorAll(
            ".sidebar .nav-item"
        )
        .forEach(
            function(item){

                const text =
                    item.innerText
                    .replace(/\s+/g," ")
                    .trim();

                if(text){

                    item.dataset.bnxLabel =
                        text;

                    item.title =
                        text;
                }

            }
        );


    function setSidebarState(
        collapsed,
        remember
    ){

        document.body
            .classList
            .toggle(
                "bnx-sidebar-collapsed",
                collapsed
            );


        toggle.setAttribute(
            "aria-expanded",
            collapsed
                ? "false"
                : "true"
        );


        toggle.setAttribute(
            "aria-label",
            collapsed
                ? "Expand sidebar"
                : "Collapse sidebar"
        );


        toggle.title =
            collapsed
                ? "Expand sidebar"
                : "Collapse sidebar";


        if(remember){

            try{

                localStorage.setItem(
                    storageKey,
                    collapsed
                        ? "1"
                        : "0"
                );

            }catch(error){
                /* preference storage optional */
            }

        }

    }


    let initialState = false;


    try{

        initialState =
            localStorage.getItem(
                storageKey
            ) === "1";

    }catch(error){

        initialState =
            false;
    }


    setSidebarState(
        initialState,
        false
    );


    toggle.addEventListener(
        "click",
        function(){

            setSidebarState(
                !document.body
                    .classList
                    .contains(
                        "bnx-sidebar-collapsed"
                    ),
                true
            );

        }
    );

})();

</script>


<script src="{% static 'js/saved_collections.js' %}?v=20260818_v1"></script>
</body>

</html>